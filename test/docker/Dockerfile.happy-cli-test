FROM node:24-slim

ARG GIT_HASH=unknown
LABEL git.hash=${GIT_HASH}

# Route apt to Tencent Cloud CN mirror over HTTPS — deb.debian.org is
# GFW-unreliable from CN. Two non-obvious requirements when building behind a
# host Clash proxy (see project gotcha fakeip-cert-hijack):
#   1. The mirror is HTTPS-only (port 80 refuses), so URIs must be forced to
#      https:// — the node:24-slim deb822 default is http://deb.debian.org.
#   2. The proxy terminates TLS with a cert the empty base-image trust store
#      rejects, and ca-certificates cannot be installed before apt works
#      (chicken-and-egg). So disable apt TLS peer verification for the bootstrap;
#      package integrity is still guaranteed by the GPG-signed InRelease, not TLS.
# node:24-slim is Debian 12 (bookworm) using the deb822 format at
# /etc/apt/sources.list.d/debian.sources; legacy sources.list handled as fallback.
RUN sed -i 's|http://deb.debian.org|https://mirrors.cloud.tencent.com|g; s|https://deb.debian.org|https://mirrors.cloud.tencent.com|g; s|http://security.debian.org|https://mirrors.cloud.tencent.com|g; s|https://security.debian.org|https://mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    sed -i 's|http://deb.debian.org|https://mirrors.cloud.tencent.com|g; s|https://deb.debian.org|https://mirrors.cloud.tencent.com|g; s|http://security.debian.org|https://mirrors.cloud.tencent.com|g; s|https://security.debian.org|https://mirrors.cloud.tencent.com|g' \
        /etc/apt/sources.list 2>/dev/null || true; \
    printf 'Acquire::https::Verify-Peer "false";\nAcquire::https::Verify-Host "false";\n' > /etc/apt/apt.conf.d/99insecure-mirror; \
    apt-get update && apt-get install -y git python3 make g++ ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99insecure-mirror

# Prisma engines mirror (binaries.prisma.sh is GFW-blocked on CN servers)
ENV PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

RUN npm install -g pnpm@10.11.0 --registry https://registry.npmmirror.com -q 2>/dev/null

WORKDIR /app

# Copy workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches/ ./patches/

# Copy source packages
COPY packages/happy-wire/package.json ./packages/happy-wire/
COPY packages/happy-wire/src/ ./packages/happy-wire/src/
COPY packages/happy-wire/tsconfig.json ./packages/happy-wire/

COPY packages/happy-cli/package.json ./packages/happy-cli/
COPY packages/happy-cli/src/ ./packages/happy-cli/src/
COPY packages/happy-cli/bin/ ./packages/happy-cli/bin/
COPY packages/happy-cli/scripts/ ./packages/happy-cli/scripts/
COPY packages/happy-cli/tsconfig.json ./packages/happy-cli/

COPY packages/happy-server/package.json ./packages/happy-server/
COPY packages/happy-server/sources/ ./packages/happy-server/sources/
COPY packages/happy-server/tsconfig.json ./packages/happy-server/
COPY packages/happy-server/prisma/ ./packages/happy-server/prisma/

# Use hoisted node-linker so node_modules are real files (no symlinks that break across installs)
RUN echo "node-linker=hoisted" >> .npmrc && \
    echo "registry=https://registry.npmmirror.com" >> .npmrc
RUN pnpm install --filter "@slopus/happy-wire..." --ignore-scripts
RUN pnpm install --filter "@easyfan/happy..." --ignore-scripts
RUN pnpm install --filter "happy-server..." --ignore-scripts
# Generate Prisma client (skipped by --ignore-scripts above)
RUN cd /app/packages/happy-server && npx prisma generate

# Build
RUN pnpm --filter @slopus/happy-wire build
RUN pnpm --filter @easyfan/happy build

ENV HAPPY_SERVER_URL="http://host.docker.internal:3005"
ENV HAPPY_HOME_DIR="/root/.handy-test"

# Install claude code directly in the container
RUN npm install -g @anthropic-ai/claude-code

ENTRYPOINT ["node", "/app/packages/happy-cli/bin/happy.mjs"]
CMD ["--help"]
