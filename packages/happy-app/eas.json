{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "EXPO_NO_DOCTOR": "1"
      }
    },
    "development-store": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "store",
      "env": {
        "APP_ENV": "development",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "EXPO_NO_DOCTOR": "1"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "preview-store": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "ENABLE_GMS": "1",
        "EXPO_PUBLIC_HAPPY_SERVER_URL": "https://happy.easyfan.info",
        "EXPO_NO_DOCTOR": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-android": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "ENABLE_GMS": "0",
        "EXPO_PUBLIC_HAPPY_SERVER_URL": "https://happy.easyfan.info",
        "EXPO_NO_DOCTOR": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "development-store": {
      "ios": {
        "appleId": "steve@bulkovo.com",
        "ascAppId": "6748984254",
        "appleTeamId": "466DQWDR8C"
      }
    },
    "preview-store": {
      "ios": {
        "appleId": "steve@bulkovo.com",
        "ascAppId": "6749025570",
        "appleTeamId": "466DQWDR8C"
      }
    },
    "production": {
      "ios": {
        "appleId": "zheng.easyfan@gmail.com",
        "appleTeamId": "57U7YLZHZ8",
        "ascAppId": "6767959890"
      }
    }
  }
}
